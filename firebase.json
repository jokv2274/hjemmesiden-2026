{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "firestore.rules",
      "storage.rules"
    ],
    "rewrites": [
      { "source": "/ai-kunst", "destination": "/galleri1.html" },
      { "source": "/dyr", "destination": "/galleri2.html" },
      { "source": "/ferie", "destination": "/galleri3.html" },
      { "source": "/natur", "destination": "/galleri4.html" },
      { "source": "/by", "destination": "/galleri5.html" },
      { "source": "/kreative-prosjekter", "destination": "/galleri6.html" },
      { "source": "/humor", "destination": "/galleri7.html" },
      { "source": "/bilder/ferie", "destination": "/galleri3.html" },
      { "source": "/bilder/dyr-natur", "destination": "/bilder-dyr-natur.html" },
      { "source": "/bilder/fugl", "destination": "/bilder-fugl.html" },
      { "source": "/bilder/norge", "destination": "/bilder-norge.html" },
      { "source": "/bilder/ai-kunst", "destination": "/galleri1.html" },
      { "source": "/bilder/by-urban", "destination": "/galleri5.html" },
      { "source": "/bilder/kreative-prosjekter", "destination": "/galleri6.html" },
      { "source": "/bilder/humor", "destination": "/galleri7.html" },
      { "source": "/historie/siberut-2000", "destination": "/historie-siberut-2000.html" }
    ]
  }
}
